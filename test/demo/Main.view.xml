<mvc:View controllerName="kor.ui.demo.Main" height="100%" displayBlock="true" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns:k="kor.ui" xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
<mvc:dependents><k:CommandPalette id="palette" run=".onCommand">
<k:Command key="akis" text="Akışa git" hint="" icon="waves" group="Git"/><k:Command key="siparis" text="Siparişlere git" hint="10.000 satır" icon="table-2" group="Git"/><k:Command key="pano" text="İş panosuna git" hint="" icon="kanban" group="Git"/><k:Command key="plan" text="Üretim planına git" hint="" icon="calendar-range" group="Git"/><k:Command key="maliyet" text="Maliyet ağacına git" hint="" icon="layers" group="Git"/><k:Command key="bilesen" text="Bileşenlere git" hint="" icon="blocks" group="Git"/><k:Command key="blocked" text="Bloke siparişleri göster" hint="Siparişler, süzülmüş" icon="octagon-alert" group="Sık kullanılan"/><k:Command key="big" text="500 bin üstü siparişler" hint="Siparişler, süzülmüş" icon="hand-coins" group="Sık kullanılan"/><k:Command key="theme" text="Açık / koyu görünüm" hint="" icon="moon" group="Görünüm"/><k:Command key="look" text="Kurum rengini değiştir" hint="Renk, yoğunluk, köşe" icon="palette" group="Görünüm"/><k:Command key="rtl" text="Sağdan sola dene" hint="RTL yerleşim" icon="arrow-left" group="Görünüm"/>
</k:CommandPalette><k:Dialog open="{/newOpen}" title="Yeni sipariş" subtitle="Taslak olarak başlar" width="720"><k:Form id="newForm" stacked="true"><k:FormSection><k:LookupField label="Müşteri" required="true" value="{/draft/firmId}" text="{/draft/firm}" infoPath="city" rows="{/customers}" placeholder="Ad veya numara yazın, F4 ile arayın"><k:columns><k:Column label="Müşteri no" path="id" width="120"/><k:Column label="Ad" path="name" width="180" grow="1"/><k:Column label="Şehir" path="city" width="130"/><k:Column label="Limit" path="limit" type="number" width="130"/><k:Column label="Risk" path="risk" type="status" width="120" states="{/risks}"/></k:columns><k:filterFields><k:FilterField label="Ad" path="name"/><k:FilterField label="Şehir" path="city" type="option" options="{/cities}"/><k:FilterField label="Limit" path="limit" type="number" unit="TRY"/></k:filterFields></k:LookupField><k:TextField label="Ürün" required="true" value="{/draft/item}"/><k:NumberField label="Adet" value="{/draft/qty}" unit="adet" min="1"/><k:NumberField label="Tutar" value="{/draft/amount}" unit="TRY" decimals="2" step="500" min="0"/><k:DateField label="Termin" required="true" value="{/draft/due}" workdays="true" marks="{/marks}"/><k:MultiSelect label="Etiketler" placeholder="Seçin" selectedKeys="{/draft/tags}" items="{path:'/tags',templateShareable:false}"><core:Item key="{key}" text="{name}"/></k:MultiSelect></k:FormSection><k:FormSection columns="1"><k:RadioGroup cards="true" label="Teslimat" selectedKey="{/draft/ship}"><k:RadioItem key="kara" text="Karayolu" help="3 iş günü" icon="truck"/><k:RadioItem key="depo" text="Depodan teslim" help="Aynı gün" icon="warehouse"/><k:RadioItem key="kargo" text="Kargo" help="2 iş günü, 30 kg'a kadar" icon="package"/></k:RadioGroup></k:FormSection></k:Form><k:footer><k:Button text="Vazgeç" press=".onNewCancel"/><k:Button kind="accent" icon="check" text="Siparişi oluştur" press=".onNewSave"/></k:footer></k:Dialog>
<k:Popover id="popover" title="Dönem"><k:DateRangeField label="Aralık" start="{/samples/from}" end="{/samples/to}"/><k:Toggle text="Taslakları da say" selected="{/samples/toggle}"/><k:footer><k:Button kind="primary" text="Uygula" press=".onPopoverClose"/></k:footer></k:Popover>
</mvc:dependents>
<k:Shell brand="kor" title="Kuzey Makine, Kasım 2026" selectedKey="{/page}" navigate=".onNavigate">
<k:items><k:NavItem key="akis" text="Akış" icon="waves" group="" count=""/><k:NavItem key="siparis" text="Siparişler" icon="table-2" group="" count="10.000"/><k:NavItem key="pano" text="İş panosu" icon="kanban" group="" count="11"/><k:NavItem key="plan" text="Üretim planı" icon="calendar-range" group="" count=""/><k:NavItem key="maliyet" text="Maliyet ağacı" icon="layers" group="" count=""/><k:NavItem key="bilesen" text="Bileşenler" icon="blocks" group="Paket" count=""/></k:items>
<k:footer><k:Person name="Elif Aydın" role="Finans müdürü"/></k:footer>
<k:actions><k:Button class="dSearch" icon="search" text="Ara veya git" label="Ara veya git" hint="⌘K" press=".onPalette"/><k:Button kind="ghost" icon="palette" label="Görünüm" press=".onLook"/><k:Button kind="ghost" icon="{= ${/look/mode} === 'dark' ? 'sun' : 'moon' }" label="Açık / koyu" press=".onMode"/></k:actions>

<k:Stack gap="30" visible="{= ${/page} === 'akis' }">
<k:Stack class="dNight" gap="8">
<k:Stack row="true" justify="space-between" align="flex-start" gap="20"><k:Stat hero="true" label="Bu dönem kasaya giren" value="{/cash}" decimals="1" unit="mn TRY" delta="{/delta}" note="önceki döneme göre"/><k:Segmented label="Dönem" selectedKey="{/period}" change=".onPeriod"><core:Item key="hafta" text="Hafta"/><core:Item key="ay" text="Ay"/><core:Item key="ceyrek" text="Çeyrek"/></k:Segmented></k:Stack>
<k:Flow id="flow" height="390" label="Tekliften tahsilata akış" selectedKey="{/stage}" select=".onStage" nodes="{/flow/nodes}" links="{/flow/links}"><k:nodes><k:FlowNode key="{key}" label="{label}" note="{note}" column="{column}" value="{value}" state="{state}"/></k:nodes><k:links><k:FlowLink source="{source}" target="{target}" value="{value}"/></k:links></k:Flow>
</k:Stack>
<k:Stack class="dPage" gap="36">
<k:Stack columns="minmax(0,1.5fr) minmax(320px,1fr)" gap="36">
<k:Stack gap="18"><k:Stack gap="2"><k:Text kind="title" text="Tahsilat planın üstünde kapandı"/><k:Text kind="muted" text="Aylık, milyon TRY"/></k:Stack><k:Trend label="Aylık tahsilat ve plan, milyon TRY" labels="{/months}" unit="mn" height="250"><k:Series name="Tahsilat" kind="area" values="{/cashIn}"/><k:Series name="Plan" kind="ghost" values="{/cashPlan}"/></k:Trend></k:Stack>
<k:Stack class="dCard" gap="16"><k:Stack row="true" justify="space-between"><k:Text kind="title" text="Kararınızı bekleyen"/><k:Text kind="muted" text="{path:'/decision', formatter:'.decisionText'}" visible="{path:'/decision', formatter:'.decisionOpen'}"/></k:Stack>
<k:Stack id="decision" class="dDecision" gap="14" binding="{/decisions/0}" visible="{path:'/decision', formatter:'.decisionOpen'}"><k:Text class="dAmount" text="{amount}"/><k:Stack gap="3"><k:Text kind="heading" text="{firm}"/><k:Text text="{text}"/></k:Stack><k:Stack row="true" justify="space-between" gap="12"><k:Person name="{owner}" role="Talep eden"/><k:Status state="wait" text="{why}"/></k:Stack><k:HoldButton text="Onaylamak için basılı tutun" doneText="Onaylandı" confirm=".onDecide"/><k:Button kind="ghost" wide="true" text="Sonra bakarım" press=".onSkip"/></k:Stack>
<k:Empty visible="{= ${/decision} > 2 }" icon="check-check" title="Masa temiz" text="Bugün bekleyen karar kalmadı."><k:Button text="Baştan göster" icon="undo-2" press=".onRestart"/></k:Empty></k:Stack>
</k:Stack>
<k:Stack gap="14"><k:Stack gap="2"><k:Text kind="title" text="{/stageTitle}"/><k:Text kind="muted" text="Yukarıdaki nehirde bir durağa basın, liste ona göre süzülür."/></k:Stack>
<k:DataGrid id="stageGrid" label="Duraktaki siparişler" height="368px" rows="{path:'/orders'}" rowPress=".onRow"><k:columns><k:Column label="Sipariş" path="id" type="link" width="112" pinned="true"/><k:Column label="Müşteri" path="firm" width="160" grow="1"/><k:Column label="Ürün" path="item" width="150" grow="1"/><k:Column label="Durum" path="status" type="status" width="140" states="{/states}"/><k:Column label="Tutar" path="amount" type="currency" unitPath="currency" decimals="2" width="160"/><k:Column label="Termin" path="due" type="date" width="112"/></k:columns></k:DataGrid></k:Stack>
</k:Stack></k:Stack>

<k:Stack class="dPage dFill" gap="14" visible="{= ${/page} === 'siparis' }">
<k:Stack row="true" justify="space-between"><k:Variants title="true" shareable="true" standardText="Siparişler" storageKey="kor-demo-orders" targets="filter grid"/><k:Stack row="true" gap="8"><k:Button icon="columns-3" label="Sütunlar" press=".onColumns"/><k:Button icon="download" text="Dışa aktar" press=".onToast"/><k:Button kind="primary" icon="plus" text="Yeni sipariş" press=".onNew"/></k:Stack></k:Stack>
<k:FilterBar id="filter" change=".onFilter" placeholder="Süz: “ada”, “onayda” ya da “&gt;500 bin” yazın"><k:FilterField label="Durum" path="status" type="option" options="{/statuses}"/><k:FilterField label="Tutar" path="amount" type="number" unit="TRY"/><k:FilterField label="Müşteri" path="firm"/><k:FilterField label="Ürün" path="item"/><k:FilterField label="Sorumlu" path="owner"/></k:FilterBar>
<k:DataGrid id="grid" class="dGrow" label="Siparişler" height="100%" selectionMode="Multi" rows="{/orders}" rowPress=".onRow" selectionChange=".onPicked" cellChange=".onCell"><k:columns><k:Column label="Sipariş" path="id" type="link" width="112" pinned="true"/><k:Column label="Müşteri" path="firm" width="165" grow="1" editable="true"/><k:Column label="Ürün" path="item" width="145" grow="1"/><k:Column label="Durum" path="status" type="status" width="142" states="{/states}" options="{/statuses}" editable="true"/><k:Column label="Adet" path="qty" type="number" width="82" editable="true"/><k:Column label="Tutar" path="amount" type="currency" unitPath="currency" decimals="2" width="158" editable="true"/><k:Column label="Termin" path="due" type="date" width="120" editable="true"/><k:Column label="İlerleme" path="progress" type="progress" width="140"/><k:Column label="Sorumlu" path="owner" type="person" width="160"/><k:Column label="Talep" path="trend" type="spark" width="116" sortable="false"/></k:columns></k:DataGrid>
<k:Stack class="dBulk" row="true" gap="6" visible="{= ${/picked} > 0 }"><k:Text text="{/pickedText}"/><k:Button kind="accent" icon="send" text="Onaya gönder" press=".onBulk"/><k:Button kind="ghost" icon="x" label="Seçimi kaldır" press=".onBulkClear"/></k:Stack>
</k:Stack>

<k:Stack class="dPage dFill" gap="18" visible="{= ${/page} === 'pano' }">
<k:Stack gap="4"><k:Text kind="display" text="İş panosu"/><k:Text kind="muted" text="Kartı sürükleyin ya da odaklanıp Ctrl ve ok tuşlarıyla taşıyın. Sınırı aşan sütun uyarır."/></k:Stack>
<k:Stack class="dGrow"><k:Board id="board" label="İş panosu" columns="{/columns}" cards="{/cards}" cardMove=".onCardMove"><k:columns><k:BoardColumn key="{key}" title="{title}" limit="{limit}" state="{state}"/></k:columns><k:cards><k:BoardCard key="{key}" column="{column}" title="{title}" text="{text}" meta="{meta}" person="{person}" tag="{tag}" state="{state}"/></k:cards></k:Board></k:Stack>
</k:Stack>

<k:Stack class="dPage" gap="18" visible="{= ${/page} === 'plan' }">
<k:Stack gap="4"><k:Text kind="display" text="Üretim planı"/><k:Text kind="muted" text="İşi sürükleyin, kenarından uzatın ya da başka hatta taşıyın. Klavyede ok tuşları taşır, Shift ile uzar."/></k:Stack>
<k:Schedule id="plan" label="Üretim planı" start="2026-11-16" today="2026-11-24" days="28" lanes="{/lanes}" tasks="{/tasks}" taskChange=".onTaskChange"><k:lanes><k:ScheduleLane key="{key}" title="{title}" text="{text}" capacity="{capacity}"/></k:lanes><k:tasks><k:ScheduleTask key="{key}" lane="{lane}" title="{title}" text="{text}" start="{start}" end="{end}" progress="{progress}" state="{state}"/></k:tasks></k:Schedule>
</k:Stack>

<k:Stack class="dPage dFill" gap="14" visible="{= ${/page} === 'maliyet' }">
<k:Stack row="true" justify="space-between"><k:Stack gap="2"><k:Variants title="true" standardText="Maliyet ağacı" storageKey="kor-demo-costs" targets="tree"/><k:Text kind="muted" text="Bütçe ve gerçekleşen, birimden kaleme. Sağ ok açar, sol ok kapatır."/></k:Stack><k:Stack row="true" gap="8"><k:Segmented label="Düzey" selectedKey="1" change=".onLevel"><core:Item key="0" text="Kapalı"/><core:Item key="1" text="Birim"/><core:Item key="2" text="Kalem"/></k:Segmented><k:Button icon="columns-3" label="Sütunlar" press=".onTreeColumns"/></k:Stack></k:Stack>
<k:TreeGrid id="tree" class="dGrow" label="Maliyet merkezleri" height="100%" rows="{path:'/costs', parameters:{arrayNames:['children']}}"><k:columns><k:Column label="Maliyet merkezi" path="name" width="280" grow="1" pinned="true"/><k:Column label="Kod" path="code" width="90"/><k:Column label="Sorumlu" path="owner" type="person" width="170"/><k:Column label="Bütçe" path="budget" type="number" width="140"/><k:Column label="Gerçekleşen" path="actual" type="number" width="140"/><k:Column label="Kalan" path="diff" type="number" width="130"/><k:Column label="Kullanım" path="used" type="progress" width="170"/></k:columns></k:TreeGrid>
</k:Stack>

<k:Stack class="dPage" gap="0" visible="{= ${/page} === 'bilesen' }">
<k:Stack class="dHero" gap="12"><k:Text kind="display" text="İş uygulamaları için, UI5 üstünde"/><k:Text kind="muted" text="Hepsi gerçek UI5 kontrolü: XML görünümde yazılır, modele bağlanır, klavyeyle çalışır. Büyük parçalar (Flow, DataGrid, Board, Schedule, Shell) soldaki sayfalarda."/></k:Stack>
<k:Tabs label="Bileşen grupları" class="dTabs" selectedKey="{/gallery}"><k:Tab key="giris" text="Giriş" icon="pencil" count="9"><k:Stack class="dRow" columns="260px minmax(0,1fr)" gap="36"><k:Stack gap="4"><k:Text kind="heading" text="Düğmeler"/><k:Text kind="muted" text="Tek birincil eylem, gerisi sakin. Menü düğmenin içinde."/><k:Text kind="muted" text="Button"/></k:Stack><k:Stack row="true" gap="10"><k:Button kind="primary" text="Kaydet" hint="⌘S"/><k:Button kind="accent" icon="send" text="Onaya gönder"/><k:Button text="Vazgeç"/><k:Button kind="ghost" icon="copy" text="Kopyala"/><k:Button kind="danger" icon="trash-2" text="Sil"/><k:Button text="İşlemler" menuSelect=".onMenu"><k:MenuItem key="Yazdır" text="Yazdır" icon="printer"/><k:MenuItem key="Dışa aktar" text="Dışa aktar" icon="download"/><k:MenuItem key="Sil" text="Sil" icon="trash-2" danger="true"/></k:Button><k:Button loading="true" text="Kaydediliyor"/><k:Button icon="sap-icon://add" label="Ekle"/></k:Stack></k:Stack><k:Stack class="dRow" columns="260px minmax(0,1fr)" gap="36"><k:Stack gap="4"><k:Text kind="heading" text="Basılı tut"/><k:Text kind="muted" text="Yanlış tıklamayla ödeme gitmez. Klavyede iki basış yeter."/><k:Text kind="muted" text="HoldButton"/></k:Stack><k:Stack row="true" gap="10"><k:Stack class="dHold"><k:HoldButton id="holdSample" text="Ödemeyi göndermek için basılı tutun" doneText="Ödeme gönderildi" icon="landmark"/></k:Stack><k:Button kind="ghost" icon="undo-2" text="Baştan" press=".onHoldReset"/></k:Stack></k:Stack><k:Stack class="dRow" columns="260px minmax(0,1fr)" gap="36"><k:Stack gap="4"><k:Text kind="heading" text="Form alanları"/><k:Text kind="muted" text="Etiket, yardım ve hata alanın parçası. Miktar etiketini sağa sola sürükleyin."/><k:Text kind="muted" text="TextField, NumberField, SelectField, DateField, DateRangeField"/></k:Stack><k:Stack columns="repeat(2, minmax(0,1fr))" gap="20"><k:TextField label="Müşteri" value="{/samples/name}" required="true"/><k:SelectField label="Ö