{
  "name": "kor-ui5",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise components for OpenUI5 and SAPUI5 (UI5 >= 1.108)",
  "license": "Apache-2.0",
  "author": "Lütfullah Kabalak",
  "homepage": "https://lutfullahkabalak.github.io/kor-ui5/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lutfullahkabalak/kor-ui5.git"
  },
  "bugs": {
    "url": "https://github.com/lutfullahkabalak/kor-ui5/issues"
  },
  "keywords": [
    "ui5",
    "openui5",
    "sapui5",
    "components",
    "enterprise",
    "fiori",
    "odata",
    "datagrid",
    "design-system"
  ],
  "engines": {
    "node": ">=22"
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "ui5 serve --port 8095 --open test-resources/kor/ui/demo/index.html",
    "start:latest": "ui5 serve --config ui5-latest.yaml --port 8096 --open test-resources/kor/ui/demo/index.html",
    "icons": "node scripts/icons.mjs",
    "build:interfaces": "ts-interface-generator || ts-interface-generator",
    "typecheck": "npm run build:interfaces && tsc --noEmit",
    "build": "npm run typecheck && ui5 build --clean-dest && node scripts/pack.mjs",
    "test": "node scripts/test.mjs",
    "release:check": "npm run build && npm test && cd npm && npm pack --dry-run"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@openui5/ts-types-esm": "1.108.51",
    "@types/qunit": "2.19.14",
    "@ui5/cli": "4.1.0",
    "@ui5/ts-interface-generator": "0.12.0",
    "lucide-static": "1.79.0",
    "puppeteer-core": "25.18.1",
    "typescript": "5.9.3",
    "ui5-tooling-transpile": "3.14.1"
  }
}
